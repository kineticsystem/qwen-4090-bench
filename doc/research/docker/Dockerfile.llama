# Build-and-run image for llama.cpp-family engines (CUDA 12.8, sm_89 / RTX 4090).
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
      git cmake ninja-build build-essential ccache curl ca-certificates \
      python3 python3-pip python3-venv libcurl4-openssl-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --break-system-packages requests huggingface_hub
WORKDIR /work
